Subject: add a Windows host stub so the shared library compiles for flutter test

Applies to: tailscale 0.7.1 (pub.dev), github.com/danReynolds/tailscale_dart
Tracked by: aer-works/baton#958
Apply with: pixi run mobile-patch

The package's Go library does not compile for GOOS=windows: udp_fd_posix.go,
http_fd_posix.go, tcp_fd_posix.go and reactor.go are all !windows, while lib.go,
node_gate.go and cmd/dylib/main.go reference their symbols unconditionally (pub.dev
lists the platforms as Android/iOS/Linux/macOS — no Windows). flutter test builds the
native asset for the *host*, so on a Windows dev host the whole test suite dies before
a single test runs.

This adds the minimum for the dylib to compile and load: empty registries, no-op
close/reset hooks, an error-returning Reactor surface (the same posture as upstream's
reactor_unsupported.go), and the Identity field the dylib entry point reads on the two
_unsupported request types. The Dart test suite never opens a tailnet — its transport
tests run against mock sockets — so the stub is honest for tests while real tailnet
networking on Windows stays unsupported, exactly as upstream declares.

diff --git go/host_stub_windows.go go/host_stub_windows.go
new file mode 100644
--- /dev/null
+++ go/host_stub_windows.go
@@ -0,0 +1,68 @@
+//go:build windows
+
+// Windows host stub — enough for the shared library to compile so `flutter test` can run
+// on a Windows dev host. The Dart test suite never opens a tailnet (its transport tests run
+// against mock sockets), so these registries stay empty and the close/reset hooks are no-ops.
+// Real tailnet networking on Windows stays unsupported, same as upstream declares.
+package tailscale
+
+import (
+	"errors"
+	"net"
+	"net/http"
+	"sync"
+	"unsafe"
+)
+
+// Mirrors http_fd_posix.go's httpTransportCache closely enough for node_gate.go's
+// snapshot reads (mu, transport); the cache never fills because HttpBind is unsupported here.
+type httpTransportCache struct {
+	mu        sync.Mutex
+	owner     any
+	transport *http.Transport
+}
+
+var tailnetHTTPTransports httpTransportCache
+
+type httpBindingState struct{}
+
+type udpBridge struct{}
+
+var (
+	httpBindingRegistry = map[int64]*httpBindingState{}
+	httpBindingMu       sync.Mutex
+
+	tcpFdListenerRegistry = map[int64]net.Listener{}
+	tcpFdListenerMu       sync.Mutex
+
+	udpFdBindingRegistry = map[int64]*udpBridge{}
+	udpFdBindingMu       sync.Mutex
+)
+
+func closeAllUdpBindings() {}
+
+func resetTailnetHTTPTransport() {}
+
+// The fd reactor (reactor.go, !windows) backs the shared POSIX socket path — its whole
+// public surface returns "unsupported" here, matching reactor_unsupported.go's posture.
+var errReactorUnsupported = errors.New("fd reactor is not supported on windows")
+
+func ReactorCreate() (int64, error) { return 0, errReactorUnsupported }
+
+func ReactorClose(id int64) error { return errReactorUnsupported }
+
+func ReactorWake(id int64) error { return errReactorUnsupported }
+
+func ReactorRegister(id int64, fd int, transportID int64, events int) error {
+	return errReactorUnsupported
+}
+
+func ReactorUpdate(id int64, fd int, transportID int64, events int) error {
+	return errReactorUnsupported
+}
+
+func ReactorUnregister(id int64, fd int) error { return errReactorUnsupported }
+
+func ReactorWait(id int64, out unsafe.Pointer, maxEvents int, timeoutMillis int) (int, error) {
+	return 0, errReactorUnsupported
+}
diff --git go/http_fd_unsupported.go go/http_fd_unsupported.go
--- go/http_fd_unsupported.go
+++ go/http_fd_unsupported.go
@@ -24,6 +24,7 @@
 	Host           string
 	Proto          string
 	Headers        map[string][]string
+	Identity       *nodeIdentity
 	ContentLength  int64
 	RemoteAddress  string
 	RemotePort     int
diff --git go/tcp_fd_unsupported.go go/tcp_fd_unsupported.go
--- go/tcp_fd_unsupported.go
+++ go/tcp_fd_unsupported.go
@@ -40,6 +40,7 @@
 	LocalPort     int
