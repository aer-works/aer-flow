<!-- #1071: the ▤ front door's first-run / empty surface (docs/design/02-screens.md:28-46, "First
     run"). The recents cards and the "Waiting on you" decision inbox that used to live here are gone:
     the permanent switcher already lists every room, and the inbox relocated to the switcher's
     "needs you" filter (#1072). What remains is the one thing this surface is for — pointing Baton at
     a folder — plus the readiness line, which answers the least self-evident first failure ("it can't
     find claude") before it is hit (#478). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aer.Ui.Core;assembly=Aer.Ui.Core"
             x:Class="Aer.Ui.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <!-- Space.6 (24px) inlined for Margin — DynamicResource can't cross double->Thickness. -->
    <StackPanel Margin="24" Spacing="{DynamicResource Space.8}" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="display" Text="Point Baton at a folder" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="A room is a conversation about one folder. Open one and start talking; add a second worker whenever it is worth it." />
      </StackPanel>

      <!-- The empty state (Phase 5, #190): first run, no history yet. x:Name EmptyStateCard is
           journey J8's desktop seam (#313) — the view-mounted test asserts this card shows with real,
           live Start-from-template / Create-workflow actions on an empty first run, not a blank wall. -->
      <Border x:Name="EmptyStateCard" Classes="card" IsVisible="{Binding Home.HasNoRooms}">
        <StackPanel Spacing="{DynamicResource Space.2}">
          <TextBlock Classes="body-strong" Text="No rooms yet." />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Start from a pre-authored template — or create a custom workflow below." />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
            <Button x:Name="StartTemplateButton" Classes="accent"
                    HorizontalAlignment="Left" Click="OnStartTemplateClick">
              <AccessText Text="_Start from template" />
            </Button>
            <Button x:Name="CreateWorkflowButton"
                    HorizontalAlignment="Left" Click="OnCreateWorkflowClick">
              <AccessText Text="_Create custom workflow" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="heading" Text="Open a room" />
        <!-- #212: the text box stays as a visible, hand-editable fallback (never the only way in) —
             Browse is the primary path for a user with no reliable way to type a correct path. -->
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
          <TextBlock Text="Room directory:" VerticalAlignment="Center" />
          <TextBox x:Name="RoomDirectoryPathBox" Width="420" />
          <Button x:Name="BrowseRoomDirectoryButton" Click="OnBrowseRoomDirectoryClick"
                  ToolTip.Tip="Pick a room folder instead of typing its path">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}">
              <Path Classes="action-icon" Data="{StaticResource Icon.Folder}"
                    StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
              <AccessText Text="_Browse…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenButton"><AccessText Text="_Open" /></Button>
          <Button x:Name="RefreshButton"><AccessText Text="Re_fresh" /></Button>
        </StackPanel>
      </StackPanel>

      <!-- Readiness up front (02-screens.md:44, #478): the most likely first failure ("it can't find
           claude") is the least self-evident, so which CLIs were detected is stated here rather than
           discovered. Same source as Settings and Author — NewWorkflow.VendorReadinessLines — one
           derivation, several contexts (02-screens.md:285), never a second copy. -->
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="heading" Text="Workers" />
        <ItemsControl ItemsSource="{Binding NewWorkflow.VendorReadinessLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="secondary" Text="{Binding}" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
